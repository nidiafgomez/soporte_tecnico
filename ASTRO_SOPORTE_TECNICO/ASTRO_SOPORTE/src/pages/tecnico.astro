---
import Layout from '../layouts/Layout.astro';
import AgGrid from '../components/AgGrid.astro';
import { getTokenSRR } from '../utils/auth';

const token = getTokenSRR(Astro.cookies);

let solicitudes = [];

if (token) {
    const res = await fetch('http://127.0.0.1:8010/solicitudes/tecnico', {
        headers: { 'Authorization': `Bearer ${token}` }
    });
    const data = await res.json();
    if (data.success) {
        solicitudes = data.data;
    }
}

const cabeceras = solicitudes.length > 0
    ? Object.keys(solicitudes[0]).filter(k => k !== 'descripcion')
    : ['id', 'asunto', 'estado', 'prioridad'];
---

<Layout title="Panel tecnico">
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Panel del tecnico</h1>
            <button id="logoutBtn" class="btn btn-outline-danger">Cerrar sesion</button>
        </div>

        <AgGrid data={solicitudes} heders={cabeceras} />

        <div class="card p-4 mt-4">
            <h5>Consultar archivos de una solicitud</h5>
            <div class="d-flex gap-2">
                <input type="number" id="idConsulta" class="form-control" placeholder="ID de la solicitud" style="max-width:200px" />
                <button id="btnVerArchivos" class="btn btn-secondary">Ver archivos</button>
            </div>
            <div id="listaArchivos" class="mt-3"></div>
        </div>
    </div>
</Layout>

<script>
    const logoutBtn = document.getElementById('logoutBtn');
    if (logoutBtn) {
        logoutBtn.addEventListener('click', async () => {
            await fetch('/api/logout', { method: 'POST' });
            window.location.href = '/';
        });
    }

    document.addEventListener('edit-row', (e: any) => {
        const row = e.detail;
        const nuevoEstado = prompt('Nuevo estado (Pendiente / En proceso / Cerrada):', row.estado);
        if (nuevoEstado) {
            fetch('/api/cambiar-estado', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: row.id, estado: nuevoEstado })
            }).then(() => window.location.reload());
        }
    });

    document.addEventListener('tomar-row', (e: any) => {
        const row = e.detail;
        if (confirm(`¿Deseas tomar la solicitud #${row.id}?`)) {
            fetch('/api/asignar-tecnico', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: row.id })
            }).then(() => window.location.reload());
        }
    });

    const btnVerArchivos = document.getElementById('btnVerArchivos');
    const idConsulta = document.getElementById('idConsulta') as HTMLInputElement | null;
    const listaArchivos = document.getElementById('listaArchivos');

    if (btnVerArchivos && idConsulta && listaArchivos) {
        btnVerArchivos.addEventListener('click', async () => {
            const id = idConsulta.value;
            if (!id) return;

            const res = await fetch(`/api/archivos-solicitud?id=${id}`);
            const data = await res.json();

            if (data.success && data.data.length > 0) {
                listaArchivos.innerHTML = data.data.map((a: any) =>
                    `<a href="${a.ruta_archivo}" target="_blank" class="d-block">${a.nombre_archivo}</a>`
                ).join('');
            } else {
                listaArchivos.innerHTML = '<p class="text-muted">No hay archivos para esta solicitud</p>';
            }
        });
    }
</script>