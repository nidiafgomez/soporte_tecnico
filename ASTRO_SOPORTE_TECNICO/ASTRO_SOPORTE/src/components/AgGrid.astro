---
const { data, heders } = Astro.props;

const lista = btoa(JSON.stringify(data));
const cabecera = btoa(JSON.stringify(heders));
---

<div class="container mb-4">
  <div
    id="myGrid"
    style="height: 500px; width: 100%;"
    data-datos={lista}
    data-cabecera={cabecera}
  >
  </div>
</div>

<script>
  import {
    createGrid,
    ModuleRegistry,
    AllEnterpriseModule,
  } from "ag-grid-enterprise";

  ModuleRegistry.registerModules([AllEnterpriseModule]);

  const gridEl = document.getElementById("myGrid") as HTMLElement;

  const base64 = gridEl.dataset.datos ?? "";
  const cabecera = gridEl.dataset.cabecera ?? "";
  const cabeceraTabla = JSON.parse(atob(cabecera));

  let gridApi;

  const gridOptions = {
    statusBar: {
      statusPanels: [
        { statusPanel: "agSelectedRowCountComponent", align: "left" },
        { statusPanel: "agFilteredRowCountComponent", align: "left" },
        { statusPanel: "agTotalRowCountComponent", align: "center" },
        { statusPanel: "agAggregationComponent", align: "right" },
      ],
    },
    defaultColDef: {
      flex: 1,
      filter: true,
      floatingFilter: true,
      enableRowGroup: true,
      enableValue: true,
    },
    sideBar: {
      toolPanels: [
        {
          id: "columns",
          labelDefault: "Columnas",
          labelKey: "columns",
          iconKey: "columns",
          toolPanel: "agColumnsToolPanel",
        },
        {
          id: "filters",
          labelDefault: "Filtros",
          labelKey: "filters",
          iconKey: "filter",
          toolPanel: "agFiltersToolPanel",
        },
      ],
      defaultToolPanel: "columns",
    },
    enableRangeSelection: true,
    rowData: JSON.parse(atob(base64)),
    columnDefs: [
      ...cabeceraTabla.map((campo: string) => ({
        field: campo,
        headerName: campo.charAt(0).toUpperCase() + campo.slice(1),
        sortable: true,
        filter: true,
        resizable: true,
      })),
      {
        headerName: "Acciones",
        field: "acciones",
        sortable: false,
        filter: false,
        resizable: false,
        pinned: "left",
        width: 140,
        cellRenderer: (params: any) => {
          const container = document.createElement("div");
          container.style.cssText =
            "display:flex; gap:6px; align-items:center; height:100%; justify-content:center;";

          const contenedorBotones = document.createElement("div");
          contenedorBotones.className = "btn-group";

          const btnEdit = document.createElement("button");
          btnEdit.title = "Editar";
          btnEdit.className = "btn btn-primary";
          btnEdit.innerHTML = '<i class="bi bi-pencil-square"></i>';
          btnEdit.onclick = () => {
            document.dispatchEvent(
              new CustomEvent("edit-row", { detail: params.data })
            );
          };

          const btnTomar = document.createElement("button");
          btnTomar.title = "Tomar solicitud";
          btnTomar.className = "btn btn-success";
          btnTomar.innerHTML = '<i class="bi bi-check2-square"></i>';
          btnTomar.onclick = () => {
            document.dispatchEvent(
              new CustomEvent("tomar-row", { detail: params.data })
            );
          };

          contenedorBotones.append(btnEdit, btnTomar);
          container.appendChild(contenedorBotones);
          return container;
        },
      },
    ],
    pagination: true,
    wrapText: true,
    autoHeight: true,
    wrapHeaderText: true,
    autoHeaderHeight: true,
    onGridReady: (params: any) => {
      gridApi = params.api;
    },
  };

  const myGridElement = document.querySelector("#myGrid") as HTMLElement;
  createGrid(myGridElement, gridOptions);
</script>